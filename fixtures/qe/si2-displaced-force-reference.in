&CONTROL
  calculation = 'scf'
  prefix = 'si2-displaced-force-reference'
  restart_mode = 'from_scratch'
  pseudo_dir = './pseudopotentials'
  outdir = './qe-si2-displaced-force-reference-tmp'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 12.0
  ecutrho = 48.0
  input_dft = 'pz'
  occupations = 'fixed'
  nspin = 1
  nosym = .true.
  noinv = .true.
/
&ELECTRONS
  conv_thr = 1.0d-12
  electron_maxstep = 100
  mixing_mode = 'plain'
  mixing_beta = 0.3
  diagonalization = 'david'
/
ATOMIC_SPECIES
Si 28.0855 Si.pz-vbc.UPF
CELL_PARAMETERS bohr
0.0000000000 5.1250000000 5.1250000000
5.1250000000 0.0000000000 5.1250000000
5.1250000000 5.1250000000 0.0000000000
ATOMIC_POSITIONS crystal
Si 0.000000000000 0.000000000000 0.000000000000
Si 0.245121951220 0.254878048780 0.254878048780
K_POINTS gamma
